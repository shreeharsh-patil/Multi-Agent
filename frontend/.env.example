# NextAuth (v4)
NEXTAUTH_URL=http://localhost:3000
# REQUIRED: NEXTAUTH_SECRET must be set to a strong random value. The app
# refuses to start (JWT forgery risk) rather than falling back to a known key.
NEXTAUTH_SECRET=generate-a-long-random-string-here
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
