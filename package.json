{
  "name": "agentic",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic AI Platform with Google ADK orchestration",
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "backend:dev": "cd backend && uvicorn src.main:app --reload",
    "backend:install": "cd backend && pip install -r requirements.txt"
  },
  "workspaces": [
    "frontend",
    "shared"
  ],
  "dependencies": {
    "ws": "^8.21.1",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  }
}
