# App
APP_NAME=Agentic AI Platform
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-this-in-production

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agentic
MONGODB_DB_NAME=agentic

# Vector DB
VECTOR_DB_PROVIDER=chroma  # chroma for dev, qdrant for prod
QDRANT_HOST=localhost
QDRANT_PORT=6333
CHROMA_PERSIST_DIR=./chroma_data

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# Google Drive
GOOGLE_DRIVE_CREDENTIALS_PATH=

# Logging
LOG_LEVEL=INFO
