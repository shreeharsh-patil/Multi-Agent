# App
APP_NAME=Agentic AI Platform
APP_VERSION=0.1.0
# `debug` enables the development-only identity fallback (X-User-Id header).
# It must stay false in production. Defaults to false.
DEBUG=false
# REQUIRED OUTSIDE DEBUG: a strong random SECRET_KEY (>=16 chars) for JWT
# signing. The backend refuses to start with a weak/known key when not in debug.
SECRET_KEY=generate-a-long-random-string-here

# OPT-IN ONLY: when false (default), generated/untrusted code is never executed
# directly on the backend host; it only runs in remote sandboxes.
ALLOW_LOCAL_CODE_EXECUTION=false

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agentic
MONGODB_DB_NAME=agentic

# Vector DB
VECTOR_DB_PROVIDER=chroma  # chroma for dev, qdrant for prod
QDRANT_HOST=localhost
QDRANT_PORT=6333
CHROMA_PERSIST_DIR=./chroma_data

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADK_ENABLED=true
EMBEDDING_MODEL=text-embedding-004

# Google Drive
GOOGLE_DRIVE_CREDENTIALS_PATH=

# Logging
LOG_LEVEL=INFO
