# =============================================================================
# Agentic AI Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-key-in-production
# Comma-separated frontend origins. Vercel preview URLs are also accepted by
# the backend CORS regex; keep the production URL here explicitly.
ALLOWED_ORIGINS=https://agentcampus.vercel.app,http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/agentic
MONGODB_DB_NAME=agentic

# --- Vector Database (chroma | qdrant) ---
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_data

# Qdrant (only if VECTOR_DB_PROVIDER=qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- LLM Provider Selection (gemini | openrouter | groq) ---
LLM_PROVIDER=gemini

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
ADK_ENABLED=true
EMBEDDING_MODEL=text-embedding-004

# --- OpenRouter (OpenAI-compatible) ---
# Sign up at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq ---
# Sign up at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Image generation (auto | openai | stability) ---
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
STABILITY_API_KEY=

# --- Browser scraping (optional Obscura CDP endpoint) ---
OBSCURA_CDP_URL=
OBSCURA_TIMEOUT_SECONDS=30

# --- Voice transcription and text-to-speech ---
DEEPGRAM_API_KEY=

# --- Google Drive Integration ---
GOOGLE_DRIVE_CREDENTIALS_PATH=

# --- Logging ---
LOG_LEVEL=INFO
CHAT_STREAM_TIMEOUT_SECONDS=120
CHAT_CONTEXT_TIMEOUT_SECONDS=45

# --- Frontend (NextAuth) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-nextauth-secret

# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
