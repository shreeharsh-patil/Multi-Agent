# =============================================================================
# Multi-Agent AI Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-key-in-production

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/multi-agent-platform
MONGODB_DB_NAME=multi-agent-platform

# --- Vector Database (chroma | qdrant) ---
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_data

# Qdrant (only if VECTOR_DB_PROVIDER=qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# --- Google Drive Integration ---
GOOGLE_DRIVE_CREDENTIALS_PATH=

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend (NextAuth) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-nextauth-secret

# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
